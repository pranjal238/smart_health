# ==========================================
# FallGuard AI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME=FallGuard AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Security & Authentication
SECRET_KEY=fallguard-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
DATABASE_URL=sqlite:///./fall_guard.db

# Machine Learning & Inference
MODEL_PATH=data/models/fall_detection_model.joblib
METRICS_PATH=reports/model_metrics.json
SAMPLING_RATE=50
WINDOW_SIZE_SECONDS=2.56
WINDOW_OVERLAP=0.50

# Fall Detection Confidence & Risk Thresholds
FALL_CONFIDENCE_HIGH=0.85
FALL_CONFIDENCE_MEDIUM=0.60
ALERT_COOLDOWN_SECONDS=5
